# ─── Supabase ────────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com
# Service role key (Settings → API → service_role)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ─── Client (Vite exposes VITE_* to the browser) ─────────────────────────────
# Same URL as SUPABASE_URL above
VITE_SUPABASE_URL=
# Anon/publishable key (Settings → API → anon public)
VITE_SUPABASE_PUBLISHABLE_KEY=

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
# Powers the AI tutor for free-tier sessions. BYOK users supply their own key at runtime.
ANTHROPIC_API_KEY=

# ─── Encryption ───────────────────────────────────────────────────────────────
# AES-256 key for encrypting user-supplied API keys at rest in Supabase.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── ElevenLabs TTS (optional) ────────────────────────────────────────────────
# Leave blank to disable voice narration (app works fine without it).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ─── Analytics (optional) ─────────────────────────────────────────────────────
# Leave blank to disable PostHog analytics entirely.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ─── Server ───────────────────────────────────────────────────────────────────
# Port for the WebSocket + HTTP server. Default: 3001
PORT=3001
